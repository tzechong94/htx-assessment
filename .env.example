# Used by `pnpm dev` (local, non-Docker). Docker Compose sets its own DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/task_assignment

# Get a free key at https://aistudio.google.com/apikey. Without it, tasks created
# without skills are saved with no skills and a warning is logged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
